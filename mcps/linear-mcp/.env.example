# Linear personal API key.
#
# Create at: Linear -> Settings -> Account -> Security & Access -> Personal API keys.
# Scope it to what you need (Read, Write, Create issues, Create comments, Admin).
#
# GOTCHA: Linear personal API keys go in the Authorization header RAW, with no
# "Bearer " prefix. OAuth tokens use "Bearer <token>"; personal keys do not.
# Sending "Bearer lin_api_..." returns 400 AUTHENTICATION_ERROR.
LINEAR_API_KEY=

# Optional. Default team key (e.g. "ENG") used when a tool call omits one.
LINEAR_DEFAULT_TEAM=
