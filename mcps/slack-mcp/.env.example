# Slack bot token for this MCP.
#
# Create a Slack app at https://api.slack.com/apps, add the bot scopes you need
# (chat:write, channels:read, reactions:write, files:write at minimum), install
# it to your workspace, and copy the Bot User OAuth Token (xoxb-...) here.
#
# The bot must be invited to a channel before it can post there.
SLACK_BOT_TOKEN=

# Optional. Display name the bot posts under. Without it, messages show the
# Slack app's own name, which is usually not what you want.
SLACK_DEFAULT_USERNAME=

# Optional. Channel used when a call does not name one (id C... or #name).
SLACK_DEFAULT_CHANNEL=
