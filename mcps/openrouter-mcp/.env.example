# OpenRouter MCP credentials
# Copy to .env and fill in. Never commit .env.
# Get a key at https://openrouter.ai/keys

OPENROUTER_API_KEY=

# Optional overrides (defaults shown)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_DEFAULT_MODEL=openai/gpt-4o
# OPENROUTER_MAX_PANEL=4
# OPENROUTER_DEFAULT_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
# OPENROUTER_IMAGE_DIR=output          # relative paths resolve against this folder

# Optional attribution on OpenRouter's public app leaderboard (not sent if unset)
# OPENROUTER_SITE_URL=https://example.com
# OPENROUTER_SITE_NAME=My App
